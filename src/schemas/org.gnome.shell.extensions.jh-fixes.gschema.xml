<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.jh-fixes" path="/org/gnome/shell/extensions/jh-fixes/">

    <key name="panel-activities-button" type="b">
      <default>true</default>
      <summary>Show the Activities button</summary>
    </key>
    <key name="clock-style" type="s">
      <choices>
        <choice value="default"/>
        <choice value="time"/>
      </choices>
      <default>'default'</default>
      <summary>What the top bar clock shows</summary>
    </key>

    <key name="panel-layout" type="a{sas}">
      <default>{}</default>
      <summary>Where the top bar items go</summary>
    </key>
    <key name="hidden-panel-items" type="as">
      <default>[]</default>
      <summary>Hidden top bar items</summary>
    </key>
    <key name="known-panel-items" type="a{sas}">
      <default>{}</default>
      <summary>Other extensions' top bar items seen so far</summary>
    </key>
    <key name="present-panel-items" type="as">
      <default>[]</default>
      <summary>Top bar items GNOME shows right now</summary>
    </key>

    <key name="hidden-quick-settings" type="as">
      <default>[]</default>
      <summary>Hidden Quick Settings items</summary>
    </key>
    <key name="quick-settings-order" type="as">
      <default>[]</default>
      <summary>Order of the Quick Settings items</summary>
    </key>
    <key name="quick-settings-widths" type="a{si}">
      <default>{}</default>
      <summary>Quick Settings item widths</summary>
    </key>
    <key name="quick-settings-columns" type="i">
      <range min="1" max="4"/>
      <default>2</default>
      <summary>Number of Quick Settings columns</summary>
    </key>
    <key name="known-quick-settings-items" type="a{ss}">
      <default>{}</default>
      <summary>Other extensions' Quick Settings items seen so far</summary>
    </key>
    <key name="known-quick-settings-icons" type="a{ss}">
      <default>{}</default>
      <summary>Icons of other extensions' Quick Settings items</summary>
    </key>
    <key name="known-quick-settings-kinds" type="a{ss}">
      <default>{}</default>
      <summary>Shapes of other extensions' Quick Settings items</summary>
    </key>
    <key name="present-quick-settings-items" type="as">
      <default>[]</default>
      <summary>Quick Settings items GNOME shows right now</summary>
    </key>
    <key name="quick-settings-prefs-button" type="b">
      <default>true</default>
      <summary>Show a jh-fixes Settings button in Quick Settings</summary>
    </key>
    <key name="ddc-brightness" type="b">
      <default>false</default>
      <summary>Brightness slider for external monitors</summary>
    </key>
    <key name="sound-app-volumes" type="b">
      <default>false</default>
      <summary>Application volume sliders in Quick Settings</summary>
    </key>
    <key name="known-output-devices" type="a{ss}">
      <default>{}</default>
      <summary>Output devices seen so far</summary>
    </key>
    <key name="output-device-names" type="a{ss}">
      <default>{}</default>
      <summary>Custom output device names</summary>
    </key>
    <key name="hidden-output-devices" type="as">
      <default>[]</default>
      <summary>Hidden output devices</summary>
    </key>
    <key name="known-input-devices" type="a{ss}">
      <default>{}</default>
      <summary>Input devices seen so far</summary>
    </key>
    <key name="input-device-names" type="a{ss}">
      <default>{}</default>
      <summary>Custom input device names</summary>
    </key>
    <key name="hidden-input-devices" type="as">
      <default>[]</default>
      <summary>Hidden input devices</summary>
    </key>

    <key name="dash-visible" type="b">
      <default>true</default>
      <summary>Show the dash</summary>
    </key>
    <key name="dash-max-icon-size" type="i">
      <range min="16" max="64"/>
      <default>48</default>
      <summary>Largest dash icon size</summary>
    </key>
    <key name="dash-show-apps-button" type="b">
      <default>true</default>
      <summary>Show the Show Apps button in the dash</summary>
    </key>

    <key name="overview-window-titles" type="b">
      <default>true</default>
      <summary>Show window titles in the Overview</summary>
    </key>
    <key name="app-grid-columns" type="i">
      <range min="0" max="12"/>
      <default>0</default>
      <summary>Columns per app grid page</summary>
    </key>
    <key name="app-grid-rows" type="i">
      <range min="0" max="8"/>
      <default>0</default>
      <summary>Rows per app grid page</summary>
    </key>

    <key name="window-corners" type="b">
      <default>false</default>
      <summary>Round the corners of windows</summary>
    </key>
    <key name="show-desktop" type="b">
      <default>false</default>
      <summary>Show Desktop shortcut</summary>
    </key>
    <key name="show-desktop-shortcut" type="as">
      <default><![CDATA[['<Super>d']]]></default>
      <summary>Show Desktop shortcut keys</summary>
    </key>

    <key name="alt-tab-mode" type="s">
      <choices>
        <choice value="apps"/>
        <choice value="windows"/>
      </choices>
      <default>'apps'</default>
      <summary>What Alt+Tab switches between</summary>
    </key>
    <key name="alt-tab-window-style" type="s">
      <choices>
        <choice value="gnome"/>
        <choice value="thumbnails"/>
        <choice value="icons"/>
        <choice value="both"/>
      </choices>
      <default>'gnome'</default>
      <summary>How the window switcher shows windows</summary>
    </key>
    <key name="alt-tab-popup-delay" type="i">
      <range min="0" max="1000"/>
      <default>150</default>
      <summary>Alt+Tab popup delay, in milliseconds</summary>
    </key>

    <key name="shell-theme" type="b">
      <default>false</default>
      <summary>Use the Umbra shell theme</summary>
    </key>
    <key name="shell-theme-palette" type="s">
      <choices>
        <choice value="darker"/>
        <choice value="catppuccin"/>
        <choice value="osaka-jade"/>
      </choices>
      <default>'darker'</default>
      <summary>Colour theme of the shell theme</summary>
    </key>
    <key name="shell-theme-disabled-styles" type="as">
      <default>[]</default>
      <summary>Umbra style parts that are switched off</summary>
    </key>
    <key name="shell-theme-panel" type="s">
      <choices>
        <choice value="black"/>
        <choice value="theme"/>
        <choice value="transparent"/>
        <choice value="dynamic"/>
      </choices>
      <default>'black'</default>
      <summary>Top bar background</summary>
    </key>
    <key name="shell-theme-panel-solid" type="s">
      <choices>
        <choice value="theme"/>
        <choice value="black"/>
      </choices>
      <default>'theme'</default>
      <summary>Dynamic top bar background while a window touches it</summary>
    </key>
    <key name="shell-theme-panel-shadow" type="i">
      <range min="0" max="100"/>
      <default>50</default>
      <summary>Text and icon shadow on a transparent top bar, in percent</summary>
    </key>
    <key name="shell-theme-radius" type="i">
      <range min="0" max="40"/>
      <default>20</default>
      <summary>Corner radius of the shell, in pixels</summary>
    </key>
    <key name="shell-theme-slider-height" type="i">
      <range min="4" max="20"/>
      <default>12</default>
      <summary>Quick Settings slider thickness, in pixels</summary>
    </key>
    <key name="shell-theme-menu-shadow" type="i">
      <range min="0" max="100"/>
      <default>35</default>
      <summary>Popup menu shadow strength, in percent</summary>
    </key>
    <key name="shell-theme-dash-style" type="s">
      <choices>
        <choice value="umbra"/>
        <choice value="gnome"/>
      </choices>
      <default>'umbra'</default>
      <summary>Dash style</summary>
    </key>
    <key name="animation-duration" type="i">
      <range min="10" max="400"/>
      <default>100</default>
      <summary>Animation duration in percent</summary>
    </key>
  </schema>
</schemalist>
